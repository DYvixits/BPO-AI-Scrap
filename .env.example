# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# --- Backend ---
# In docker-compose these hostnames resolve to the postgres/redis services.
# For local (non-docker) dev, point at localhost instead.
DATABASE_URL=postgresql+asyncpg://bpo:bpo@postgres:5432/bpo_ai_scrap
REDIS_URL=redis://redis:6379/0

# JWT signing secret — MUST be overridden with a long random value outside
# local dev. The app refuses to boot with this placeholder when
# ENVIRONMENT=production.
SECRET_KEY=change-me-dev-only-not-a-real-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Crawler
CRAWLER_USER_AGENT=BPOAIScrapBot/0.1 (+https://github.com/DYvixits/bpo-ai-scrap)
CRAWLER_MAX_RESPONSE_BYTES=10485760
CRAWLER_REQUEST_TIMEOUT_SECONDS=15
CRAWLER_MAX_CONCURRENCY=8

# --- Frontend (frontend/.env) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1
